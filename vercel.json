{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/opengraph-image",
      "destination": "/opengraph-image.png",
      "permanent": true
    },
    {
      "source": "/blog/:slug/opengraph-image",
      "destination": "/blog/:slug/opengraph-image.png",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(admin\\.webm|businessFormula\\.webm|dashboard\\.webm|home-work\\.mp4|leads\\.webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
