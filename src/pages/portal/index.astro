---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFrame from "@/components/app/SiteFrame";
import PortalPageContent from "@/components/portal/PortalPageContent";
import { getPortalAccessByEmail, hasActivePortalAccess } from "@/lib/portal-access";

export const prerender = false;

const session = Astro.locals.session;

if (!session?.user?.email) {
  return Astro.redirect("/login");
}

let portalAccess = null;

try {
  portalAccess = await getPortalAccessByEmail(
    session.user.email,
    session.user.id,
  );
} catch (error) {
  console.error("[Portal] Failed to verify portal access", error);
  return Astro.redirect("/login?access=unavailable");
}

if (!hasActivePortalAccess(portalAccess)) {
  return Astro.redirect("/login?access=denied");
}
---

<BaseLayout
  metadata={{
    title: "Portal",
    robots: {
      index: false,
      follow: false,
    },
  }}
>
  <SiteFrame client:load pathname="/portal">
    <PortalPageContent
      displayName={session.user.name || portalAccess.displayName || "Portal user"}
      email={session.user.email}
      role={portalAccess.role}
    />
  </SiteFrame>
</BaseLayout>
