---
import RfpPreviewRouteClient from "@/components/app/routes/RfpPreviewRouteClient";
import RouteShell from "@/components/app/RouteShell.astro";
import { getPortalAccessByEmail, hasActivePortalAccess } from "@/lib/portal-access";

export const prerender = false;

const session = Astro.locals.session;

if (!session?.user?.email) {
  return Astro.redirect("/login");
}

let portalAccess = null;

try {
  portalAccess = await getPortalAccessByEmail(
    session.user.email,
    session.user.id,
  );
} catch (error) {
  console.error("[Portal] Failed to verify preview access", error);
  return Astro.redirect("/login?access=unavailable");
}

if (!hasActivePortalAccess(portalAccess)) {
  return Astro.redirect("/login?access=denied");
}
---

<RouteShell
  metadata={{
    title: "RFP Preview Studio",
    robots: {
      index: false,
      follow: false,
    },
  }}
  pathname="/portal/rfp-preview"
>
  <RfpPreviewRouteClient client:load pathname="/portal/rfp-preview" />
</RouteShell>
