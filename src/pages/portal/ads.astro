---
import RouteShell from "@/components/app/RouteShell.astro";
import AdsDashboardRouteClient from "@/components/app/routes/AdsDashboardRouteClient";
import { getPortalAccessByEmail, hasActivePortalAccess } from "@/lib/portal-access";

export const prerender = false;

const session = Astro.locals.session;
if (!session?.user?.email) {
  return Astro.redirect("/login");
}

const access = await getPortalAccessByEmail(
  session.user.email,
  session.user.id,
).catch(() => null);

if (!hasActivePortalAccess(access) || access.role !== "admin") {
  return Astro.redirect("/portal");
}
---

<RouteShell
  metadata={{
    title: "Google Ads Control Room",
    robots: { index: false, follow: false },
  }}
  pathname="/portal/ads"
>
  <AdsDashboardRouteClient client:load pathname="/portal/ads" />
</RouteShell>
