---
import RouteShell from "@/components/app/RouteShell.astro";
import AdLandingRouteClient from "@/components/app/routes/AdLandingRouteClient";
import {
  adLandingPages,
  getAdLandingPage,
} from "@/components/ads/adLandingPages";
import { SITE_URL } from "@/utils/site";
import type { RouteMetadata } from "@/utils/metadata";

export function getStaticPaths() {
  return adLandingPages.map((page) => ({
    params: { adSlug: page.slug },
    props: { page },
  }));
}

const page =
  Astro.props.page ?? getAdLandingPage(String(Astro.params.adSlug || ""));

if (!page) {
  throw new Error(`Unknown ad landing page: ${Astro.params.adSlug}`);
}

const metadata: RouteMetadata = {
  title: {
    absolute: `${page.eyebrow} | Free Workflow Assessment`,
  },
  description: page.lead,
  robots: {
    index: false,
    follow: false,
  },
  alternates: {
    canonical: `${SITE_URL}/${page.organicSlug}`,
  },
  openGraph: {
    title: page.h1,
    description: page.lead,
    url: `${SITE_URL}/ads/${page.slug}`,
  },
};
---

<RouteShell metadata={metadata} pathname={`/ads/${page.slug}`} hideChat>
  <AdLandingRouteClient
    client:load
    pathname={`/ads/${page.slug}`}
    page={page}
  />
</RouteShell>
