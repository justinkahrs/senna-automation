---
import RouteShell from "@/components/app/RouteShell.astro";
import HomeRouteClient from "@/components/app/routes/HomeRouteClient";
import { metadata } from "@/site/pages/home";
import { getAllBlogPostsFromContent } from "@/utils/astro-blog";

const posts = await getAllBlogPostsFromContent();
const latestPost = posts[0]
  ? {
      slug: posts[0].slug,
      title: posts[0].title,
      excerpt: posts[0].excerpt,
      image: posts[0].image,
    }
  : null;
---

<RouteShell metadata={metadata} pathname="/">
  <HomeRouteClient client:load pathname="/" latestPost={latestPost} />
</RouteShell>
