<script>
  import { initializeAttributionCapture } from "@/utils/attribution";

  declare global {
    interface Window {
      __sennaAnalyticsCaptureInitialized?: boolean;
    }
  }

  if (!window.__sennaAnalyticsCaptureInitialized) {
    window.__sennaAnalyticsCaptureInitialized = true;
    initializeAttributionCapture();

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element) || !window.umami) return;
      const anchor = event.target.closest("[data-track-external-link]");
      if (!(anchor instanceof HTMLAnchorElement)) return;

      window.umami.track("Clicked External Link", {
        path: window.location.pathname,
        title: document.title,
        href: anchor.dataset.trackExternalLink || anchor.href,
        label: anchor.dataset.trackExternalLabel,
      });
    });
  }
</script>
