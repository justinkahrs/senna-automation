---
const isDev = import.meta.env.DEV;
---

<script is:inline define:vars={{ isDev }}>
  (() => {
    if (window.__sennaAnalyticsCaptureInitialized) {
      return;
    }

    window.__sennaAnalyticsCaptureInitialized = true;

    const UTM_STORAGE_KEY = "utm_data";
    const UTM_PARAMS = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_term",
      "utm_content",
    ];

    function captureUtmParams() {
      if (isDev) return;

      const params = new URLSearchParams(window.location.search);
      const utm = {};
      let found = false;

      for (const key of UTM_PARAMS) {
        const value = params.get(key);
        if (value) {
          utm[key] = value;
          found = true;
        }
      }

      if (!found) return;

      try {
        utm.captured_at = new Date().toISOString();
        localStorage.setItem(UTM_STORAGE_KEY, JSON.stringify(utm));
      } catch {
        // Storage can be unavailable in restricted browser contexts.
      }
    }

    function trackExternalLink(anchor) {
      if (isDev || !window.umami) return;

      let storedUtm = null;

      try {
        const raw = localStorage.getItem(UTM_STORAGE_KEY);
        storedUtm = raw ? JSON.parse(raw) : null;
      } catch {
        storedUtm = null;
      }

      const payload = {
        path: window.location.pathname,
        title: document.title,
        ...(storedUtm ?? {}),
        href: anchor.dataset.trackExternalLink || anchor.href,
        label: anchor.dataset.trackExternalLabel,
      };

      delete payload.captured_at;
      window.umami.track("Clicked External Link", payload);
    }

    function handleDocumentClick(event) {
      if (!(event.target instanceof Element)) return;

      const anchor = event.target.closest("[data-track-external-link]");
      if (!(anchor instanceof HTMLAnchorElement)) return;

      trackExternalLink(anchor);
    }

    captureUtmParams();
    document.addEventListener("astro:page-load", captureUtmParams);
    document.addEventListener("click", handleDocumentClick);
  })();
</script>
