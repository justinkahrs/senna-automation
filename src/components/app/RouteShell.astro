---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FooterFrame from "@/components/app/FooterFrame";
import HeaderFrame from "@/components/app/HeaderFrame";
import type { RouteMetadata } from "@/utils/metadata";

interface Props {
  metadata?: RouteMetadata;
  pathname: string;
  hideChat?: boolean;
  contentId?: string;
}

const { metadata, pathname, hideChat = false, contentId } = Astro.props;
---

<BaseLayout metadata={metadata} hideChat={hideChat} contentId={contentId}>
  <HeaderFrame client:load pathname={pathname} />
  <main
    style={{
      minHeight: "100vh",
      display: "flex",
      flexDirection: "column",
      position: "relative",
      zIndex: 10,
    }}
  >
    <slot />
  </main>
  <FooterFrame pathname={pathname} currentYear={new Date().getFullYear()} />
</BaseLayout>
