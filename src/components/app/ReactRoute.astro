---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFrame from "@/components/app/SiteFrame";
import type { RouteMetadata } from "@/utils/metadata";

interface Props {
  metadata?: RouteMetadata;
  pathname: string;
}

const { metadata, pathname } = Astro.props;
---

<BaseLayout metadata={metadata}>
  <SiteFrame client:load pathname={pathname}>
    <slot />
  </SiteFrame>
</BaseLayout>
